# Copy to .env.local:  cp env.example .env.local
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=inventory_customer
# Min 16 karakter — untuk tanda tangan cookie session HttpOnly
SESSION_SECRET=ganti-dengan-string-acak-panjang-min-32-karakter

# Worker & cron (WAJIB di production)
# WORKER_SECRET=
# CRON_SECRET=

# Redis/Upstash — wajib production (rate limit + cache antar lambda)
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
# APP_CACHE_PREFIX=inventory
# REQUIRE_MONGO_TRANSACTIONS=1
# REQUIRE_REDIS_CACHE=1

# Production hardening — jangan set di go-live kecuali darurat
# ALLOW_AUTH_SEED=0
# ALLOW_SANDBOX_RESET=0
# ENABLE_SANDBOX_RESET_UI=0
# NEXT_PUBLIC_ENABLE_SANDBOX_RESET_UI=0

# Rate limit (opsional)
# RATE_LIMIT_LOGIN_MAX=20
# RATE_LIMIT_WEBHOOK_MAX=120
# RATE_LIMIT_PAIR_MAX=10

# Integrasi sales.app (opsional jika sudah pairing via /integrasi)
# SALES_APP_URL=http://localhost:3000
# SALES_API_KEY=
# SALES_VENDOR_TENANT_ID=default

# ── Observability P1 (opsional) ──────────────────────────────────────────────
# Sentry DSN — error tracking server + client
# SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456
