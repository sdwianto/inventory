# ── Inventory App — contoh environment ──
# Salin ke `.env.local` lalu isi nilai yang sesuai. JANGAN commit `.env.local`.

# ── Database (WAJIB di production) ──
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=inventory_customer
# Serverless Vercel — pool kecil per lambda (default 8 / 0)
# MONGO_MAX_POOL_SIZE=8
# MONGO_MIN_POOL_SIZE=0

# ── URL aplikasi ──
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# ── Keamanan session (WAJIB di production, min 32 karakter, acak & rahasia) ──
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# ── CORS ──
# Dev: '*' aman. Production: isi origin yang diizinkan (comma-separated).
# Jika kosong di production, header CORS tidak di-set (hanya same-origin yang jalan).
CORS_ORIGINS=*

# ── Framing / clickjacking ──
# Default production = SAMEORIGIN. Set ALLOW_FRAMING=1 hanya jika UI perlu di-embed lintas origin.
# ALLOW_FRAMING=1

# ── Akun bootstrap master (WAJIB override di production) ──
# Jika password masih default 'master123', seed akan GAGAL di production (fail closed).
# MASTER_BOOTSTRAP_EMAIL=admin@perusahaan.com
# MASTER_BOOTSTRAP_PASSWORD=ganti-dengan-password-kuat

# ── Integrasi sales.app ──
# URL sales.app (untuk sync katalog & webhook outbound)
SALES_APP_URL=http://localhost:3000
SALES_VENDOR_TENANT_ID=default

# Pairing otomatis — WAJIB di production (fail closed tanpa token).
# Jangan hardcode API key per vendor di .env production; gunakan pairing / integration_links.
# INTEGRATION_SETUP_TOKEN=token-acak-rahasia

# Opsional: API key platform sales (satu key untuk semua vendor) — disarankan multi-vendor.
# SALES_PLATFORM_API_KEY=sk_platform_...

# Webhook dari sales.app → POST /api/webhooks/sales (diisi saat pairing)
# WEBHOOK_SECRET=

# ── Cache shared antar lambda (disarankan production) ──
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx
# APP_CACHE_PREFIX=inventory

# ── Background worker (bg_jobs) ──
# WAJIB di production — gunakan cron-job.org (lihat scripts/cron-job-org-setup.md).
WORKER_SECRET=dev-worker-secret
# BG_WORKER_INTERVAL_MS=30000
# WORKER_INTERNAL_URL=http://127.0.0.1:3001

# ── Media storage (logo tenant, foto resep/aset) ──
# Dev: default = <cwd>/storage/media
# Docker/VPS: wajib path writable (lihat docker-compose volume media_data)
# MEDIA_STORAGE_PATH=/app/storage/media
# MEDIA_STORAGE_PATH=/var/lib/inventory/media

# ── Sandbox reset UI (MASTER) ──
# Dev + DEPLOYMENT_MODE=vps: aktif otomatis. Cloud production: set eksplisit.
# ENABLE_SANDBOX_RESET_UI=1
# NEXT_PUBLIC_ENABLE_SANDBOX_RESET_UI=1
# ALLOW_SANDBOX_RESET=1
# Matikan permanen (termasuk VPS): ALLOW_SANDBOX_RESET=0
# SALES_DB_NAME=kasir_db

# ── Maintenance (JANGAN set di production kecuali darurat) ──
# ALLOW_AUTH_SEED=1          # izinkan POST /auth/seed di production

# ── Rate limiting (per instance) ──
# RATE_LIMIT_LOGIN_MAX=20
# RATE_LIMIT_WEBHOOK_MAX=120
# RATE_LIMIT_PAIR_MAX=10
# RATE_LIMIT_WINDOW_MS=60000

# ── HTTPS (production behind TLS) ──
# ENABLE_HSTS=0              # set 0 untuk uji lokal tanpa HTTPS