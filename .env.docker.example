# Copy: cp .env.docker.example .env.docker
# Run:  docker compose --env-file .env.docker up --build -d
#
# Prasyarat: sibling Sales packages di ../../sales/sales/packages

NODE_ENV=production
MONGO_URL=mongodb://mongo:27017/?replicaSet=rs0
DB_NAME=inventory_customer
REDIS_URL=redis://redis:6379

SESSION_SECRET=change-me-min-32-characters-xxxxxxxxxxxx
WORKER_SECRET=change-me-worker-secret-min-16

MASTER_BOOTSTRAP_EMAIL=master@dawam.com
MASTER_BOOTSTRAP_PASSWORD=change-me-bootstrap-password
INTEGRATION_SETUP_TOKEN=change-me-integration-setup-token

NEXT_PUBLIC_BASE_URL=http://localhost:3001
SALES_APP_URL=http://localhost:3000

# Foto resep/QC — di-set otomatis di compose (volume media_data)
MEDIA_STORAGE_PATH=/app/storage/media

# HTTP VPS: biarkan 0 sampai HTTPS aktif
ENABLE_HSTS=0

# Lite stack: kosongkan DEPLOYMENT_MODE / JOB_BUS_ENABLED=0 (pakai HTTP poll worker)
# Enterprise: deploy dari sales/sales compose (job bus + execution worker)
DEPLOYMENT_MODE=
JOB_BUS_ENABLED=0
