{
    "name": "inventory-app",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "preinstall": "node scripts/ee12-install-platform.mjs",
        "postinstall": "node scripts/ee12-install-platform.mjs",
        "ee12:install-platform": "node scripts/ee12-install-platform.mjs",
        "ee12:repair": "node scripts/ee12-install-platform.mjs",
        "ee12:vendor-platform": "node scripts/ee12-install-platform.mjs",
        "ee12:consume-platform": "node scripts/ee12-consume-platform.mjs",
        "ee13:registry-smoke": "node scripts/ee13-registry-smoke.mjs",
        "typecheck:packages": "node scripts/typecheck-sdwianto-packages.mjs",
        "typecheck:contracts": "node scripts/typecheck-sdwianto-packages.mjs contracts",
        "check:execution-boundary": "node scripts/ci/check-execution-boundary.mjs",
        "check:execution-boundary:strict": "EXECUTION_BOUNDARY_STRICT=1 node scripts/ci/check-execution-boundary.mjs",
        "lint:execution-boundary": "EXECUTION_BOUNDARY_STRICT=1 node scripts/ensure-node-version.mjs && EXECUTION_BOUNDARY_STRICT=1 npx eslint --config eslint.config.mjs lib/execution lib/api/handlers",
        "test:execution:ee12": "vitest run tests/e2e/execution/ee-12-phase3-gate.test.ts tests/e2e/execution/ee-12-phase4-gate.test.ts",
        "test:execution:ee13": "vitest run tests/e2e/execution/ee-13-registry-gate.test.ts",
        "test:execution:ee14": "vitest run tests/e2e/execution/ee-14-phase1-gate.test.ts tests/e2e/execution/ee-14-phase2-gate.test.ts tests/e2e/execution/ee-14-phase3-gate.test.ts",
        "predev": "node scripts/ensure-node-version.mjs && node scripts/ensure-dev-cache.mjs && node scripts/ensure-dev-port.mjs",
        "dev": "NODE_OPTIONS='--max-old-space-size=1024' next dev --webpack --hostname 0.0.0.0 --port 3001",
        "dev:turbo": "NODE_OPTIONS='--max-old-space-size=1024' next dev --hostname 0.0.0.0 --port 3001",
        "dev:stop": "node scripts/ensure-dev-port.mjs --kill-only",
        "dev:reset": "rm -rf .next .cache/dev-route-stamp && npm run dev",
        "dev:no-reload": "next dev --webpack --hostname 0.0.0.0 --port 3001",
        "dev:webpack": "NODE_OPTIONS='--max-old-space-size=1024' next dev --webpack --hostname 0.0.0.0 --port 3001",
        "build": "node scripts/ensure-node-version.mjs && next build --webpack",
        "typecheck": "node scripts/ensure-node-version.mjs && node scripts/ee12-install-platform.mjs && tsc --noEmit",
        "lint": "node scripts/ensure-node-version.mjs && npx eslint --config eslint.config.mjs lib app components",
        "typecheck:strict": "node scripts/ensure-node-version.mjs && node scripts/ee12-install-platform.mjs && tsc -p tsconfig.strict.json --noEmit",
        "ci": "npm run typecheck && npm run typecheck:strict && npm run test:unit && npm run build",
        "test:unit": "vitest run",
        "test:fp:enterprise": "vitest run tests/unit/food-production-enterprise-gate.test.ts tests/unit/request-metrics.test.ts tests/unit/food-production-phase5-sprint19.test.ts tests/unit/food-production-phase5-sprint20.test.ts tests/unit/food-production-phase5-sprint21.test.ts tests/unit/food-production-phase5-sprint23.test.ts tests/unit/food-production-phase5-sprint24.test.ts",
        "test:multi-uom": "vitest run tests/unit/uom-conversion.test.ts tests/unit/uom-display.test.ts tests/unit/resolve-line-qty.test.ts tests/unit/grn-from-webhook.test.ts tests/unit/match-vendor-line.test.ts tests/unit/hutang-variance-uom.test.ts",
        "test:3way-match": "vitest run tests/unit/three-way-match.test.ts",
        "test:s3": "vitest run tests/unit/grn-from-webhook.test.ts tests/unit/grn-from-webhook-delivery.test.ts tests/unit/three-way-match.test.ts tests/unit/cpo-status-sync.test.ts tests/unit/customer-po-vendor.test.ts tests/unit/po-estimasi.test.ts tests/unit/line-patch.test.ts tests/unit/match-vendor-line.test.ts tests/unit/warehouse-qty.test.ts tests/unit/journal-lines-inventory.test.ts",
        "test:p1": "vitest run tests/unit/three-way-match.test.ts tests/unit/hutang-variance-uom.test.ts tests/unit/health.test.ts tests/unit/resolve-line-qty.test.ts",
        "test:p3": "vitest run tests/unit/feature-flags.test.ts tests/unit/audit-compliance.test.ts tests/unit/sentry.test.ts",
        "test:unit:watch": "vitest",
        "test:e2e": "playwright install chromium && playwright test",
        "test": "npm run test:unit",
        "test:all": "npm run test:unit && npm run test:e2e",
        "typecheck:migrate-bulk": "node scripts/ts-fix-complete.mjs && node scripts/ts-migrate-usestate.mjs && node scripts/ts-migrate-json-state.mjs",
        "start": "next start --port 3001",
        "start:standalone": "node scripts/start-standalone.mjs",
        "migrate:tenant": "node scripts/migrate-add-tenantId.js",
        "migrate:product-uom": "node scripts/migrate-product-uom.mjs",
        "test:phase5": "APP_URL=http://localhost:3001 APP_PORT=3001 python3 scripts/test_phase5_semiauto_v2.py",
        "test:phase5:mongo": "node scripts/phase5_mongo_integrity.mjs",
        "backfix:hutang": "node scripts/backfix-vendor-hutang.mjs --apply",
        "diag:hutang": "node scripts/backfix-vendor-hutang.mjs",
        "verify:sales": "node scripts/verify-sales-integration.mjs",
        "verify:production": "node scripts/verify-production-env.mjs",
        "verify:production:full": "node scripts/verify-production-env.mjs --mongo --login",
        "verify:api-key": "node scripts/verify-api-key-match.mjs",
        "repair:procurement": "node scripts/repair-procurement.mjs",
        "replay:po-vendor": "node scripts/replay-po-vendor-sync.mjs",
        "repair:api-key": "node scripts/repair-integration-api-key.mjs",
        "p0:stabilize": "node scripts/p0-stabilize.mjs",
        "doctor:integration": "node scripts/integration-doctor.mjs",
        "test:procurement-e2e": "node scripts/procurement-e2e-test.mjs",
        "diag:procurement": "node scripts/diag-procurement-e2e.mjs",
        "diag:bg-jobs": "node scripts/diagnose-bg-jobs-stale.mjs",
        "migrate:bootstrap": "node --experimental-strip-types scripts/run-bootstrap.ts",
        "migrate:email-normalized": "node scripts/backfill-email-normalized.mjs",
        "worker:bg-jobs": "node scripts/run-bg-worker.mjs",
        "execution:worker": "node scripts/ensure-node-version.mjs && node scripts/run-execution-worker.mjs",
        "execution:doctor": "node scripts/ensure-node-version.mjs && npx tsx scripts/execution-doctor.ts",
        "execution:doctor:dry-run": "node scripts/ensure-node-version.mjs && npx tsx scripts/execution-doctor.ts --dry-run",
        "migrate:bg-jobs-v1": "node scripts/ensure-node-version.mjs && node scripts/migrate-bg-jobs-v1.mjs",
        "migrate:bg-jobs-v1:dry-run": "node scripts/ensure-node-version.mjs && node scripts/migrate-bg-jobs-v1.mjs --dry-run",
        "test:execution:unit": "vitest run tests/unit/execution",
        "test:execution:integration": "vitest run tests/integration/execution",
        "test:worker": "node scripts/test-bg-worker.mjs",
        "test:load": "node scripts/load-hotpath.mjs"
    },
    "engines": {
        "node": ">=22.0.0"
    },
