{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/components/*": [
        "./components/*"
      ],
      "@/lib/*": [
        "./lib/*"
      ],
      "@/app/*": [
        "./app/*"
      ],
      "@sdwianto/contracts": [
        "./node_modules/@sdwianto/contracts/src/index.ts",
        "./_vendor/sales/packages/contracts/src/index.ts"
      ],
      "@sdwianto/contracts/*": [
        "./node_modules/@sdwianto/contracts/src/*",
        "./_vendor/sales/packages/contracts/src/*"
      ],
      "@sdwianto/platform": [
        "./node_modules/@sdwianto/platform/src/index.ts",
        "./_vendor/sales/packages/platform/src/index.ts"
      ],
      "@sdwianto/platform/*": [
        "./node_modules/@sdwianto/platform/src/*",
        "./_vendor/sales/packages/platform/src/*"
      ],
      "@sdwianto/events": [
        "./node_modules/@sdwianto/events/src/index.ts",
        "./_vendor/sales/packages/events/src/index.ts"
      ],
      "@sdwianto/events/*": [
        "./node_modules/@sdwianto/events/src/*",
        "./_vendor/sales/packages/events/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "coverage",
    "tests",
    "playwright.config.ts",
    "_vendor"
  ]
}
