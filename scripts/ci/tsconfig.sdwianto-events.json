{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "paths": {
      "@sdwianto/contracts": ["../../node_modules/@sdwianto/contracts/src/index.ts"],
      "@sdwianto/contracts/*": ["../../node_modules/@sdwianto/contracts/src/*"]
    }
  },
  "include": ["../../node_modules/@sdwianto/events/src/**/*.ts"]
}
